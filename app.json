{
  "name": "smartrouter-mon",
  "description": "SmartRouter on Monad: AI model routing paid from an on-chain vault, with public receipts and ratings.",
  "stack": "heroku-24",
  "buildpacks": [{ "url": "heroku/nodejs" }],
  "formation": {
    "web": { "quantity": 1, "size": "basic" },
    "worker": { "quantity": 1, "size": "basic" }
  },
  "addons": ["heroku-postgresql:essential-0", "heroku-redis:mini"],
  "env": {
    "MONAD_NETWORK": { "value": "testnet" },
    "SESSION_SECRET": { "generator": "secret" },
    "MAX_PROVIDER_PRICE_MULTIPLIER": { "value": "2" },
    "FEE_PCT": { "value": "10" },
    "NODE_ENV": { "value": "production" }
  }
}
