# Copy to .env for local dev. On Heroku (app: smartrouter-mon) these are config vars.
NODE_ENV=development

# ---- Monad (users' chain) ----
MONAD_NETWORK=testnet                 # testnet (10143) | mainnet (143)
MONAD_CHAIN_ID=10143                  # optional sanity check
MONAD_RPC_URL=                        # Alchemy Monad endpoint (https://monad-testnet.g.alchemy.com/v2/<key>)
MONAD_RPC_FALLBACK_URL=https://testnet-rpc.monad.xyz
USDC_ADDRESS=                         # defaults: 0x534b…43A3 (testnet), 0x7547…b603 (mainnet)
VAULT_ADDRESS=                        # from contracts/deployments/<network>.json
LEDGER_ADDRESS=
VAULT_START_BLOCK=
MONAD_OPERATOR_PRIVATE_KEY=           # 0x… operator + vault payee: settles, relays signatures (needs MON for gas)
MONAD_TREASURY_ADDRESS=               # profit goes here; owner of the contracts
SPENDING_KEY_DAYS=30
ENVIO_GRAPHQL_URL=                    # Envio hosted GraphQL for the indexer (leaderboard, agent stats)

# ---- Tempo (where AI providers are paid, MPP in USDC.e) ----
TEMPO_NETWORK=tempo
TEMPO_RPC_URL=                        # optional (dRPC); defaults to the public RPC
HOT_WALLET_PRIVATE_KEY=               # 0x… pays providers on Tempo; keep a few days of float
HOT_WALLET_DAILY_LIMIT_USD=20
MOCK_PROVIDERS=false                  # true = mock replies, no provider payments (local dev)
TEMPO_TARGET_USD=15                   # Relay refill target for the Tempo hot wallet…
TEMPO_REFILL_BELOW_USD=5              # …when it drops below this (mainnet only)
RELAY_API_KEY=                        # relay.link — only for Monad USDC → Tempo USDC.e refills

# ---- Sponsors ----
PRIVY_APP_ID=                         # Privy app "SmartRouter Monad" (default network: Monad)
AURORA_API_URL=                       # Aurora Intents Connect API base URL
AURORA_API_KEY=                       # server-side only; the SDK uses /aurora/ as apiKeyProxyUrl
# Router agent: Groq free tier (GROQ_FREE_API_KEY) by default; set QWEN_API_KEY to use Qwen instead,
# or AGENT_BASE_URL / AGENT_API_KEY / AGENT_MODEL for any OpenAI-compatible API with tool calling.
AGENT_MODEL=                          # default llama-3.3-70b-versatile on Groq
AGENT_TIMEOUT_MS=6000
QWEN_API_KEY=

# ---- Settlement and revenue ----
SETTLE_IDLE_MINUTES=10
SETTLE_MIN_USD=0.05
SETTLE_MAX_USD=1
IDLE_CLOSE_HOURS=24
DEPOSIT_CHUNK_USD=2
PROFIT_ADDRESS=                       # defaults to MONAD_TREASURY_ADDRESS
HOT_WALLET_FLOAT_USD=10
PROFIT_SWEEP_MIN_USD=20
PROFIT_SWEEP_INTERVAL_HOURS=24
SPONSOR_TX_PER_DAY=20
SEND_MAX_USD=1000

# ---- Infra ----
DATABASE_URL=postgres://localhost:5432/smartrouter
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-32+-random-chars-please
APP_ORIGINS=http://localhost:5173     # comma-separated frontend origins (CORS + SIWE domain)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
UPLOADS_BUCKET=smartrouter-upload
SENTRY_DSN=
MAX_PROVIDER_PRICE_MULTIPLIER=2
FEE_PCT=10
DEFAULT_ALLOCATION_USD=2

# Free fallback model
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
FREE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
GROQ_FREE_API_KEY=
FREE_DAILY_MESSAGES=30
FREE_GLOBAL_DAILY_USD=3

# Send codes (6-digit email code before money leaves a wallet)
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=SmartRouter <onboarding@resend.dev>
SEND_CODE_ECHO=false
